@startuml
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam shadowing false

interface ApplicationState {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}

class Application {
  -currentState: ApplicationState
  -history: List<ApplicationStatusHistory>
  -observers: List<ApplicationTransitionObserver>
  +transitionTo(actor: ApplicationActor, target: ApplicationState): void
  +allowedNextActions(): Set<ApplicationState>
  +addObserver(observer: ApplicationTransitionObserver): void
}

class Submitted {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}
class Reviewed {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}
class Shortlisted {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}
class Rejected {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}
class Hired {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}
class Withdrawn {
  +allowedNextActions(): Set<ApplicationState>
  +transitionTo(application: Application, target: ApplicationState): void
}

ApplicationState <|.. Submitted
ApplicationState <|.. Reviewed
ApplicationState <|.. Shortlisted
ApplicationState <|.. Rejected
ApplicationState <|.. Hired
ApplicationState <|.. Withdrawn
Application o--> ApplicationState : currentState
Application "1" *--> "0..*" ApplicationStatusHistory : history

note right of Application
  Illegal transitions are refused
  by the current state object.
end note

note bottom of Submitted
  Legal successors: Reviewed, Withdrawn
end note
note bottom of Reviewed
  Legal successors: Shortlisted, Rejected, Withdrawn
end note
note bottom of Shortlisted
  Legal successors: Hired, Rejected, Withdrawn
end note
note bottom of Rejected
  Legal successors: none (terminal)
end note
note bottom of Hired
  Legal successors: none (final)
end note
note bottom of Withdrawn
  Legal successors: none (terminal)
end note

class ApplicationStatusHistory {
  +fromStatus: ApplicationState
  +toStatus: ApplicationState
  +actor: ApplicationActor
  +timestamp: DateTime
}

interface ApplicationTransitionObserver {
  +onSuccessfulTransition(application: Application, entry: ApplicationStatusHistory): void
}
class NotificationService {
  +onSuccessfulTransition(application: Application, entry: ApplicationStatusHistory): void
  +notifyApplicant(application: Application, entry: ApplicationStatusHistory): void
}
ApplicationTransitionObserver <|.. NotificationService
Application "1" o--> "0..*" ApplicationTransitionObserver : observers

abstract class ApplicationActor {
  +authorizeStatusChange(application: Application): bool
}
class Employer {
  +authorizeStatusChange(application: Application): bool
}
class Administrator {
  +authorizeStatusChange(application: Application): bool
}
ApplicationActor <|-- Employer
ApplicationActor <|-- Administrator
note right of Employer
  Authorization succeeds only when
  the employer owns the listing.
end note
note right of Administrator
  Application status changes
  are not authorized.
end note

class JobListing {
  -currentState: ListingState
  +submitForReview(): void
  +publish(actor: Administrator): void
  +reject(actor: Administrator): void
  +reviseAndResubmit(actor: Employer): void
  +closeOrFill(): void
}
interface ListingState {
  +publish(listing: JobListing): void
  +reject(listing: JobListing): void
  +reviseAndResubmit(listing: JobListing): void
  +closeOrFill(listing: JobListing): void
}
class PendingListing
class PublishedListing
class RejectedListing
class ClosedOrFilledListing
ListingState <|.. PendingListing
ListingState <|.. PublishedListing
ListingState <|.. RejectedListing
ListingState <|.. ClosedOrFilledListing
JobListing o--> ListingState : currentState
Employer --> JobListing : owns
JobListing "1" --> "0..*" Application : applications

@enduml
